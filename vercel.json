{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:section(admin-guide|api-and-runtime|api-guide|architecture|benchmarks|clients|configuration|deployment|getting-started|integrations|learning|mcp|memory|opensource|security|standard|telegram|user-guide|search)/:path*",
      "destination": "/agents/:section/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/:product/assets/:file*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
